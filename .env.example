# Copy to .env locally. Never commit real credentials.
OPENAQ_API_KEY=replace_with_your_openaq_key
OPENWEATHER_API_KEY=replace_with_your_openweather_key
# Legacy WeatherAPI integration remains available for existing project features.
WEATHER_API_KEY=replace_with_your_weatherapi_key
DATA_GOV_IN_API_KEY=

OPENAQ_TIMEOUT_SECONDS=12
OPENAQ_LIVE_MAX_AGE_MINUTES=180
OPENWEATHER_TIMEOUT_SECONDS=12
OPENWEATHER_LIVE_MAX_AGE_MINUTES=180
LIVE_DATA_REFRESH_SECONDS=300

# Legacy compatibility settings (used by older OpenAQ consumers).
OPENAQ_FRESH_HOURS=24
OPENAQ_DELAYED_HOURS=72
